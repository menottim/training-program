      "name": "Tab Button",
      "kind": "nav",
      "refersTo": "tab-button",
      "description": "Uppercase label in the fixed navy nav; active tab gets a coral underline.",
      "html": "<div style=\"background:#1a1a2e;border-bottom:2px solid #e94560;display:flex\"><button class=\"ds-tab\">Today</button><button class=\"ds-tab active\">Plan</button></div>",
