  "narrative": {
    "northStar": "The Clipboard",
    "overview": "A coach's sheet, not a dashboard product. Information comes first, surfaces are flat and white, and one hot accent, coral, is reserved for games and the active tab. The page is a single 900px column that reads on a phone without expanding anything, with detail folded behind toggles.\n\nState is carried by colour and border, never by decoration. A card's border says what kind of day it is: coral for a game, blue for training, green for done, grey for rest.",
    "keyCharacteristics": [
      "Flat surfaces with 1px hairline borders; almost no shadow.",
      "System font only. Hierarchy comes from weight, size and small uppercase labels.",
      "Colour is a code (game, train, done, rest), not a mood.",
      "Long text is clamped or collapsed by default; expand on tap.",
      "Every control and link has a 44px hit area on phones; no text below 11px."
    ],
    "rules": [
      {
        "name": "Colour-As-Code Rule",
        "body": "Coral means game, blue means training, green means done, grey means rest or hold, orange means caution. Do not reuse them decoratively.",
        "section": "colors"
      },
      {
        "name": "Ink Rule",
        "body": "A state colour used as text on white or a wash always uses its ink version, so every label reaches 4.5:1.",
        "section": "colors"
      },
      {
        "name": "11px Floor Rule",
        "body": "No rendered text below 11px on screen, including SVG text scaled to its rendered width.",
        "section": "typography"
      },
      {
        "name": "Small Caps Label Rule",
        "body": "Uppercase is for short labels only. Never set a sentence in uppercase.",
        "section": "typography"
      },
      {
        "name": "Flat-By-Default Rule",
        "body": "Surfaces are flat at rest. Do not add shadows to cards to make them feel raised.",
        "section": "elevation"
      }
    ],
    "dos": [
      "keep the Today Card the first thing on the page.",
      "keep each tile headline to about 8 words and fold the rest behind a toggle.",
      "use the four state colours only for their meaning.",
      "give every control and link a 44px hit area on phones (vertical padding on the inline box, not bigger text)."
    ],
    "donts": [
      "add nutrition or sleep UI. Both are retired.",
      "put citations, evidence tiers or program self-assessment in any rendered field.",
      "hardcode a schedule in `index.html`; an un-authored week must show as missing.",
      "add a webfont, framework or build step."
    ]
  }
