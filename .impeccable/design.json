      "css": ".ds-today{background:#fff;border:2px solid #0f3460;border-radius:10px;padding:1.25rem 1.5rem;box-shadow:0 2px 8px rgba(0,0,0,0.04);font-family:-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:#212529}.ds-today-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:.5rem}.ds-today-day{font-size:1.2rem;font-weight:700}.ds-today-meta{font-size:.75rem;color:#6c757d;text-transform:uppercase;letter-spacing:.5px}.ds-today-title{font-size:1rem;font-weight:600;color:#0f3460;margin-bottom:.75rem}.ds-list{list-style:none;margin:0;padding:0}.ds-list li{display:flex;justify-content:space-between;gap:1rem;padding:.4rem 0;border-bottom:1px solid #dee2e6;font-size:.9rem}"
    },
    {
